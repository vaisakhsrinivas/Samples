def compress_string(s: str) -> str:

    count = 1
    finalstring = ""
    l = len(s)

    for i in range(1,l):
        if s[i] == s[i-1]:
            count += 1
        else:
            finalstring = finalstring+s[i-1]+str(count)
            count = 1
    finalstring = finalstring+s[-1]+str(count)
    return finalstring
        

if __name__ == "__main__":
    s = input()
    res = compress_string(s)
    print(res)
